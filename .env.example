# CloudLabOS environment variables
#
# Backend settings are read by pydantic-settings with the CLOUDLABOS_ prefix.
# The prefix is REQUIRED — a variable without it is silently ignored.
# Copy the backend block into apps/api/.env, the frontend block into
# apps/web/.env.local (or set both in your host's config UI).

# ─────────────── Backend (apps/api/.env) ───────────────

# development = auto-creates tables AND seeds demo data (incl. a demo admin).
# Use "production" for anything reachable from the internet.
CLOUDLABOS_ENVIRONMENT=development

# Serves /docs and echoes SQL. Keep false in production.
CLOUDLABOS_DEBUG=true

# REQUIRED in production: 32+ chars, unique. The app refuses to start otherwise.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUDLABOS_SECRET_KEY=dev-only-change-me

# SQLite is fine locally. For hosting use Postgres — note the +asyncpg driver:
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
CLOUDLABOS_DATABASE_URL=sqlite+aiosqlite:///./cloudlabos.db

# Exact origin(s) of the deployed frontend. No wildcard with credentials.
CLOUDLABOS_CORS_ORIGINS=["http://localhost:3000"]

# ── AI: the only key needed for agent chat / agent workflow steps ──
# Get one at https://openrouter.ai/keys
CLOUDLABOS_OPENROUTER_API_KEY=
# Optional: any model slug OpenRouter supports.
CLOUDLABOS_DEFAULT_MODEL=google/gemini-2.0-flash-lite-001

# Optional: raises the GitHub research tool's rate limit (works unauthenticated).
CLOUDLABOS_GITHUB_TOKEN=

# ─────────────── Frontend (apps/web/.env.local) ───────────────

# Public URL of the backend. Must be reachable from the BROWSER, not just the server.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
