# Database
POSTGRES_PASSWORD=replace-with-a-unique-postgres-password
POSTGRES_DB=cloudlabos
POSTGRES_USER=cloudlabos

# Redis
REDIS_PASSWORD=replace-with-a-unique-redis-password

# Security
ENCRYPTION_KEY=replace-with-a-unique-32-plus-character-encryption-key
JWT_SECRET=replace-with-a-unique-32-plus-character-jwt-secret

# AI
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# YouTube (for Dr. Abhishek channel curl commands)
YOUTUBE_API_KEY=your-youtube-data-api-key
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxx  # Dr. Abhishek channel ID

# GitHub (for code research)
GITHUB_TOKEN=ghp_your_token_here

# Observability
GRAFANA_PASSWORD=replace-with-a-unique-grafana-password
LANGSMITH_API_KEY=

# Artifact Storage (local disk by default; set to s3 for S3 backend)
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_PATH=/data/artifacts
# ARTIFACT_S3_BUCKET=my-cloudlabos-artifacts   # uncomment when using s3 backend

# Services
API_GATEWAY_PORT=8000
AGENT_SERVICE_PORT=8001
WORKFLOW_ENGINE_PORT=8002
MEMORY_SERVICE_PORT=8003
BROWSER_SERVICE_PORT=8004
RESEARCH_SERVICE_PORT=8005

# App mode
ENVIRONMENT=development
NEXT_PUBLIC_DEMO_MODE=false
